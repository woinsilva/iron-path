; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Iron Path"
config/description="Tower defense 2D mobile game"
config/version="0.1.0"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.2", "Mobile")

[autoload]

GameSession="*res://autoload/game_session.gd"
SaveService="*res://autoload/save_service.gd"
AudioService="*res://autoload/audio_service.gd"
SceneRouter="*res://autoload/scene_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.91, 0.847, 0.659, 1)
